<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
          xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
          jcr:primaryType="nt:unstructured"
          jcr:title="Pokemon Type"
          sling:resourceType="cq/gui/components/authoring/dialog">
    <content
            jcr:primaryType="nt:unstructured"
            sling:resourceType="granite/ui/components/coral/foundation/container">
        <items jcr:primaryType="nt:unstructured">
            <column
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="granite/ui/components/coral/foundation/container">
                <items jcr:primaryType="nt:unstructured">
                    <title
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="granite/ui/components/foundation/form/select"
                            fieldLabel="Title"
                            name="./title">
                        <items jcr:primaryType="nt:unstructured">
                            <type
                                    jcr:primaryType="nt:unstructured"
                                    text="Type"
                                    value="Type"/>
                            <weakness
                                    jcr:primaryType="nt:unstructured"
                                    text="Weakness"
                                    value="Weakness"/>
                        </items>
                    </title>
                    <pokemonTypesWeaknesses
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="granite/ui/components/coral/foundation/form/select"
                            fieldDescription="Select the pokemon type"
                            fieldLabel="Types/Weaknesses"
                            multiple="{Boolean}true"
                            name="./typesWeaknesses"
                            required="{Boolean}true">
                        <datasource
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="aempokebootcamp/tagdropdown"
                                tagsPath="/content/cq:tags/pokemon-types"/>
                    </pokemonTypesWeaknesses>
                </items>
            </column>
        </items>
    </content>
</jcr:root>
